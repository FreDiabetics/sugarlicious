<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/wear_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wear_background"
    tools:ignore="HardcodedText,MergeRootFrame,SmallSp,UselessParent">

    <ScrollView
        android:id="@+id/wear_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="10dp"
            android:paddingEnd="24dp"
            android:paddingBottom="30dp">

            <ImageView
                android:id="@+id/wear_header_logo"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="Sugarlicious"
                android:scaleType="centerInside"
                android:src="@drawable/ic_foreground" />

            <TextView
                android:id="@+id/wear_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="7dp"
                android:includeFontPadding="false"
                android:text="Sugarlicious"
                android:textColor="@color/wear_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/wear_glucose_card"
                android:layout_width="match_parent"
                android:layout_height="98dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp">

                <LinearLayout
                    android:id="@+id/wear_glucose_info_block"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/wear_glucose_primary_row"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/wear_glucose"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="—"
                            android:textColor="@color/wear_text"
                            android:textSize="42sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/wear_trend_container"
                            android:layout_width="wrap_content"
                            android:layout_height="46dp"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/wear_trend_arrow_1"
                                android:layout_width="27dp"
                                android:layout_height="27dp"
                                android:contentDescription="Trend"
                                android:src="@drawable/ic_trend_arrow"
                                android:tint="@color/wear_text" />

                            <ImageView
                                android:id="@+id/wear_trend_arrow_2"
                                android:layout_width="27dp"
                                android:layout_height="27dp"
                                android:layout_marginStart="1dp"
                                android:contentDescription="Trend"
                                android:src="@drawable/ic_trend_arrow"
                                android:tint="@color/wear_text"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/wear_glucose_meta_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/wear_delta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="—"
                            android:textColor="@color/wear_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/wear_age"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:includeFontPadding="false"
                            android:text="—"
                            android:textColor="@color/wear_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/wear_glucose_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:text="KEINE DATEN"
                        android:textColor="@color/wear_text_secondary"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wear_basal_card"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/wear_basal_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="Basal"
                    android:src="@drawable/ic_complication_basal"
                    android:tint="@color/wear_accent" />
                <TextView android:id="@+id/wear_basal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="—" android:textColor="@color/wear_text" android:textSize="17sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wear_therapy_row"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="7dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout android:id="@+id/wear_iob_card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <ImageView android:id="@+id/wear_iob_icon" android:layout_width="23dp" android:layout_height="23dp" android:contentDescription="IOB" android:src="@drawable/ic_complication_iob" android:tint="@color/wear_accent" />
                    <TextView android:id="@+id/wear_iob" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="—" android:textColor="@color/wear_text" android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:id="@+id/wear_cob_card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="3dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <ImageView android:id="@+id/wear_cob_icon" android:layout_width="23dp" android:layout_height="23dp" android:contentDescription="COB" android:src="@drawable/ic_complication_carbs" android:tint="@color/wear_accent" />
                    <TextView android:id="@+id/wear_cob" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="—" android:textColor="@color/wear_text" android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout android:id="@+id/wear_graph_card" android:layout_width="match_parent" android:layout_height="138dp" android:layout_marginTop="7dp">
                <app.aapswear.wear.WearGlucoseChart android:id="@+id/wear_glucose_chart" android:layout_width="match_parent" android:layout_height="match_parent" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/wear_connection_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="13dp"
                android:paddingTop="10dp"
                android:paddingEnd="13dp"
                android:paddingBottom="10dp">
                <TextView android:id="@+id/wear_connection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="○ Telefon nicht erreichbar" android:textColor="@color/wear_text_secondary" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/wear_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:text="Datenquelle nicht bereit" android:textColor="@color/wear_text" android:textSize="9sp" android:textStyle="bold" />
                <TextView android:id="@+id/wear_sync_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Tippen zum Aktualisieren" android:textColor="@color/wear_text_secondary" android:textSize="8sp" />
                <TextView android:id="@+id/wear_watchface_push_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Watchface-Direktwechsel wird geprüft" android:textColor="@color/wear_text_secondary" android:textSize="7sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wear_settings_action"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="7dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView android:id="@+id/wear_settings_icon" android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="Einstellungen" android:src="@drawable/ic_settings" android:tint="@color/wear_text" />
                <TextView android:id="@+id/wear_settings_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="Watch Einstellungen" android:textColor="@color/wear_text" android:textSize="9sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:gravity="center" android:orientation="horizontal">
                <ImageView android:id="@+id/wear_footer_icon" android:layout_width="16dp" android:layout_height="16dp" android:contentDescription="Sugarlicious" android:src="@drawable/ic_monochrome_outlined" android:tint="@color/wear_green" />
                <TextView android:id="@+id/wear_footer_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="Sugarlicious · FreDiabetics" android:textColor="@color/wear_text_secondary" android:textSize="7sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
