<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/wear_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="HardcodedText,MergeRootFrame,SmallSp,UseCompoundDrawables,UselessParent">

    <ScrollView
        android:id="@+id/wear_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="30dp"
            android:paddingEnd="24dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:id="@+id/wear_glucose_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="110dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp">

                <LinearLayout
                    android:id="@+id/wear_glucose_info_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/wear_glucose_primary_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/wear_glucose"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="—"
                            android:textColor="@color/wear_text"
                            android:textSize="44sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/wear_trend_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:minHeight="46dp"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/wear_trend_arrow_1"
                                android:layout_width="27dp"
                                android:layout_height="27dp"
                                android:contentDescription="Trend"
                                android:src="@drawable/ic_trend_flat"
                                android:tint="@color/wear_text" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/wear_glucose_meta_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/wear_delta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="—"
                            android:textColor="@color/wear_text_secondary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/wear_age"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="0dp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="—"
                            android:textColor="@color/wear_text_secondary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/wear_therapy_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <app.aapswear.wear.SquareTherapyCard android:id="@+id/wear_iob_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginTop="7dp" android:layout_marginEnd="3dp" android:gravity="center" android:orientation="vertical">
                <FrameLayout android:layout_width="66dp" android:layout_height="66dp">
                    <app.aapswear.wear.WearTherapyProgressView android:id="@+id/wear_iob_progress" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
                    <TextView android:includeFontPadding="false" android:id="@+id/wear_iob" android:layout_width="46dp" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:text="—" android:textColor="@color/wear_text" android:textSize="14sp" android:textStyle="bold" />
                    <ImageView android:id="@+id/wear_iob_icon" android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="bottom|center_horizontal" android:contentDescription="IOB" android:src="@drawable/ic_iob" android:tint="@color/wear_accent" />
                </FrameLayout>
                <TextView android:includeFontPadding="false" android:id="@+id/wear_iob_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:visibility="gone" android:textColor="@color/wear_text_secondary" android:textSize="10sp" android:textStyle="bold" />
            </app.aapswear.wear.SquareTherapyCard>
            <app.aapswear.wear.SquareTherapyCard android:id="@+id/wear_cob_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginTop="7dp" android:layout_marginStart="3dp" android:gravity="center" android:orientation="vertical">
                <FrameLayout android:layout_width="66dp" android:layout_height="66dp">
                    <app.aapswear.wear.WearTherapyProgressView android:id="@+id/wear_cob_progress" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
                    <TextView android:includeFontPadding="false" android:id="@+id/wear_cob" android:layout_width="46dp" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:text="—" android:textColor="@color/wear_text" android:textSize="14sp" android:textStyle="bold" />
                    <ImageView android:id="@+id/wear_cob_icon" android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="bottom|center_horizontal" android:contentDescription="COB" android:src="@drawable/ic_cob" android:tint="@color/wear_accent" />
                </FrameLayout>
                <TextView android:includeFontPadding="false" android:id="@+id/wear_cob_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:visibility="gone" android:textColor="@color/wear_text_secondary" android:textSize="10sp" android:textStyle="bold" />
            </app.aapswear.wear.SquareTherapyCard>
            </LinearLayout>

            <LinearLayout android:baselineAligned="false" android:id="@+id/wear_basal_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="96dp" android:layout_marginTop="7dp" android:padding="9dp" android:gravity="center_vertical" android:orientation="horizontal">
                <FrameLayout android:layout_width="66dp" android:layout_height="66dp">
                    <app.aapswear.wear.WearTherapyProgressView android:id="@+id/wear_basal_progress" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
                    <TextView android:includeFontPadding="false" android:id="@+id/wear_basal" android:layout_width="46dp" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:text="—" android:textColor="@color/wear_text" android:textSize="14sp" android:textStyle="bold" />
                    <ImageView android:id="@+id/wear_basal_icon" android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="bottom|center_horizontal" android:contentDescription="Basal" android:src="@drawable/ic_complication_basal" android:tint="@color/wear_accent" />
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="37dp" android:gravity="center_vertical">
                        <ImageView android:id="@+id/wear_basal_base_icon" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_basal_bckgrnd" android:contentDescription="BR" />
                        <TextView android:includeFontPadding="false" android:id="@+id/wear_basal_base" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="3dp" android:gravity="center_vertical" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" android:textColor="@color/wear_text" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="37dp" android:gravity="center_vertical">
                        <ImageView android:id="@+id/wear_basal_temp_icon" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_basalmore_bckgrnd" android:contentDescription="TBR" />
                        <TextView android:includeFontPadding="false" android:id="@+id/wear_basal_secondary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="3dp" android:gravity="center_vertical" android:maxLines="2" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" android:textColor="@color/wear_text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <FrameLayout android:id="@+id/wear_graph_card" android:layout_width="match_parent" android:layout_height="138dp" android:layout_marginTop="7dp">
                <app.aapswear.wear.WearGlucoseChart android:id="@+id/wear_glucose_chart" android:layout_width="match_parent" android:layout_height="match_parent" />
                <TextView
                    android:id="@+id/wear_graph_period"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="72dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:gravity="center_vertical|start"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="3h • —"
                    android:textColor="@color/wear_text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@null"
                    android:clickable="true"
                    android:focusable="true" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/wear_connection_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="13dp"
                android:paddingTop="10dp"
                android:paddingEnd="13dp"
                android:paddingBottom="10dp">
                <TextView android:id="@+id/wear_connection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="○ Telefon nicht erreichbar" android:textColor="@color/wear_text_secondary" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/wear_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:text="Datenquelle nicht bereit" android:textColor="@color/wear_text" android:textSize="9sp" android:textStyle="bold" />
                <TextView android:id="@+id/wear_sync_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Tippen zum Aktualisieren" android:textColor="@color/wear_text_secondary" android:textSize="8sp" />
                <TextView android:id="@+id/wear_watchface_push_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Watchface-Direktwechsel wird geprüft" android:textColor="@color/wear_text_secondary" android:textSize="7sp" />
            </LinearLayout>

            <Button
                android:id="@+id/wear_settings_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Einstellungen" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
